DB_URL=jdbc:mysql://localhost:3306/team1_db?serverTimezone=UTC
DB_USERNAME=
DB_PASSWORD=
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true

# JWT 서명에 사용할 secret입니다. HS256 기준 최소 32바이트 이상이어야 합니다.
JWT_SECRET=change-this-secret-to-at-least-32-characters

# Access Token 만료 시간입니다. 예: 30m, 1h
JWT_ACCESS_TOKEN_EXPIRATION=1h

# Refresh Token 만료 시간입니다. 예: 7d, 14d
JWT_REFRESH_TOKEN_EXPIRATION=14d
